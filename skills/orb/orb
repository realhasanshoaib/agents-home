class OrbError(Exception):
    pass


def run(cmd, *, input=None, check=True, cwd=None):
    p = subprocess.run(cmd, input=input, text=True, capture_output=True, cwd=cwd)
    if check and p.returncode:
        raise OrbError(f"{shlex.join(cmd[:3])} failed ({p.returncode}): {(p.stderr or p.stdout or '').strip()[-600:]}")
    return p


def say(msg):
    print(f"orb: {msg}", file=sys.stderr, flush=True)


def machines():
    return json.loads(run(["instabox", "ls", "--json"]).stdout or "[]")


def machine(name):
    return next((m for m in machines() if m["name"] == name), None)


def ports(name):
    out = json.loads(run(["instabox", "port", "ls", name, "--json"]).stdout or "{}")
    return {p["port"]: p["url"] for p in out.get("ports", [])}


def instabox_exec(name, command, stdin=None, timeout=60):
    cmd = ["instabox", "exec", name, "--timeout", str(timeout)] + (["--stdin"] if stdin is not None else []) + ["--", command]
    return subprocess.run(cmd, input=stdin, capture_output=True)


def transport(name, script):
    """The one place that reaches a machine, because Instabox's SSH gateway has refused new machines since
    5 Nov 2026 ~18:00 UTC (see SKILL.md). `exec` caps a call at 10 minutes, buffers its output and can silently
    drop stdin, so the script is sent whole (the hash proves it arrived), runs detached from a RAM file, and
    this polls its log. Secrets in the script never reach an argv. Returns (exit code, combined output)."""
    job, data = f"orb-{os.getpid()}-{time.monotonic_ns()}", script.encode()
    if len(data) > 900_000:
        raise OrbError("script too large for exec stdin")
    digest = hashlib.sha256(data).hexdigest()
    base = f"/dev/shm/{job}"
    start = (f"umask 077; cat > {base}.sh; [ \"$(sha256sum < {base}.sh | cut -d' ' -f1)\" = {digest} ] || {{ echo 'stdin arrived damaged'; exit 98; }}; "
             f"setsid nohup bash -c 'bash -l {base}.sh </dev/null > {base}.log 2>&1; echo $? > {base}.exit; rm -f {base}.sh' >/dev/null 2>&1 </dev/null &")
    for attempt in range(3):
        p = instabox_exec(name, start, data)
        if p.returncode == 0:
            break
        if attempt == 2:
            raise OrbError(f"could not start a job on {name}: {(p.stdout + p.stderr).decode(errors='replace')[-400:]}")
        time.sleep(3)
    out, offset, failures = bytearray(), 0, 0
    while True:
        time.sleep(1.5)
        p = instabox_exec(name, f"cat {base}.exit 2>/dev/null || echo; tail -c +{offset + 1} {base}.log 2>/dev/null | head -c 1000000; true", timeout=30)
        if p.returncode:
            failures += 1
            if failures >= 60:
                raise OrbError(f"lost contact with {name}")
            continue
        failures = 0
        code, _, chunk = p.stdout.partition(b"\n")
        out += chunk
        offset += len(chunk)
        if code.strip() and len(chunk) < 1000000:
            instabox_exec(name, f"rm -f {base}.log {base}.exit")
            return int(code), out.decode(errors="replace")
        if len(chunk) >= 1000000:
            continue


def ssh(name, script, *, check=True):
    code, output = transport(name, script)
    p = subprocess.CompletedProcess(["transport"], code, output, "")
    if check and code:
        raise OrbError(f"on {name}: exit {code}: {output.strip()[-1000:]}")
    return p


def upload(name, data, remote_dir):
    """Unpack a tar (bytes) into remote_dir. exec stdin takes 1 MiB, so the archive goes up in base64 chunks."""
    b64 = base64.b64encode(data)
    part = f"/dev/shm/orb-upload-{os.getpid()}.b64"
    ssh(name, f": > {part}")
    for i in range(0, len(b64), 600_000):
        chunk = b64[i:i + 600_000]
        want = len(chunk)
        for attempt in range(3):
            p = instabox_exec(name, f"cat >> {part}.next && [ \"$(wc -c < {part}.next)\" = {want} ] && cat {part}.next >> {part}; rc=$?; rm -f {part}.next; exit $rc", chunk)
            if p.returncode == 0:
                break
            if attempt == 2:
                raise OrbError(f"upload to {name} failed: {p.stdout.decode(errors='replace')[-300:]}")
    ssh(name, f"[ \"$(wc -c < {part})\" = {len(b64)} ] || {{ echo 'upload incomplete'; exit 1; }}\n"
              f"mkdir -p {remote_dir} && find {remote_dir} -mindepth 1 -delete && base64 -d < {part} | tar -C {remote_dir} -x; rc=$?; rm -f {part}; exit $rc")


def download_tar(name, remote_cmd):
    """Run a command on the machine that writes a tar to stdout and return its bytes."""
    out = ssh(name, f"{remote_cmd} | base64 -w0; echo").stdout
    return base64.b64decode(out.strip().splitlines()[-1])


def orb_key(repo, branch):
    """`box` names a machine box-<checkout dir name>-<time>-<pid> (the dir name is cut to 20 characters),
    so a dir called orb-<repo>-<hash of branch> makes the machine findable by repo and branch."""
    return f"orb-{repo}-{hashlib.sha1(branch.encode()).hexdigest()[:6]}"


def find_orb(key):
    return next((m for m in machines() if m["name"].startswith(f"box-{key}-")), None)


def parse_name(name):
    m = re.fullmatch(r"box-orb-([a-z0-9]+)-[0-9a-f]{6}-\d+-\d+", name)
    if not m or m.group(1) not in PROFILES:
        raise OrbError(f"{name} is not an Orb name. `orb status` lists them.")
    return PROFILES[m.group(1)]


def resolve_secrets(profile):
    values = {}
    for key, ref in profile["secrets"].items():
        p = run(["op", "read", ref], check=False)
        if p.returncode:
            raise OrbError(f"cannot read {ref} with op: {p.stderr.strip()}")
        values[key] = p.stdout.rstrip("\n")
    return values


def exports(values):
    return "".join(f"export {k}={shlex.quote(v)}\n" for k, v in values.items())


def checkout(key, profile, branch):
    """A clone at the branch tip: `box` fetches this HEAD onto the machine."""
    d = CACHE / "repos" / key
    if not d.exists():
        d.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", "-q", "--filter=blob:none", f"https://github.com/{profile['slug']}.git", str(d)])
    run(["git", "-C", str(d), "fetch", "-q", "origin", f"+refs/heads/{branch}:refs/remotes/origin/{branch}"])
    run(["git", "-C", str(d), "checkout", "-q", "--detach", f"origin/{branch}"])
    return d, run(["git", "-C", str(d), "rev-parse", "HEAD"]).stdout.strip()


def create_machine(key, profile, branch):
    d, sha = checkout(key, profile, branch)
    extra = {"BOX_SNAPSHOT": os.environ["ORB_SNAPSHOT"]} if "ORB_SNAPSHOT" in os.environ else {}
    for attempt in (1, 2):
        p = subprocess.run([str(BOX), "run", "--keep", "--", "true"], cwd=d, text=True, capture_output=True, env={**os.environ, **extra})
        found = re.search(r"(box-\S+) is up", p.stderr)
        if not found:
            raise OrbError(f"box could not start a machine: {p.stderr.strip()[-600:]}")
        box_name = found.group(1)
        if p.returncode == 0:
            break
        run(["instabox", "rm", box_name], check=False)
        if attempt == 2:
            raise OrbError(f"box failed after creating {box_name}: {p.stderr.strip()[-600:]}")
        say(f"box exit {p.returncode} ({p.stderr.strip()[-200:]}); retrying once")
    return box_name, sha


def ensure_running(name):
    state = str(machine(name).get("state", "")).lower()
    if state != "running":
        say(f"{name} is {state}; resuming")
        run(["instabox", "resume", name], check=False)
        run(["instabox", "wake", name], check=False)


def read_meta(name):
    return json.loads(ssh(name, "cat ~/.orb.json").stdout)


def tunnel_url(name, port):
    """Stand-in while Instabox's gateway answers 503 for new machines' public ports (ORB_PUBLIC=tunnel):
    a Cloudflare quick tunnel gives the same shape of origin, an HTTPS URL that forwards to the port."""
    log = f"/tmp/cf-{port}.log"
    out = ssh(name, "[ -x ~/cloudflared ] || { curl -fsSL -o ~/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 && chmod +x ~/cloudflared; }\n"
                    f"tmux has-session -t =orbtun{port} 2>/dev/null || tmux new-session -d -s orbtun{port} \"exec ~/cloudflared tunnel --no-autoupdate --url http://localhost:{port} > {log} 2>&1\"\n"
                    f"for i in $(seq 60); do grep -om1 'https://[a-z0-9-]*\\.trycloudflare\\.com' {log} && exit 0; sleep 1; done; echo 'no tunnel URL'; exit 1\n").stdout
    return out.strip().splitlines()[-1]


def phases(marks):
    return ', '.join(f'{l} {t - (marks[i - 1][1] if i else 0):.0f}s' for i, (l, t) in enumerate(marks))


def cmd_up(repo, branch):
    repo = repo.lower().split("/")[-1]
    if repo not in PROFILES:
        raise OrbError(f"unknown repo {repo}; known: {', '.join(PROFILES)}")
    profile = PROFILES[repo]
    key = orb_key(repo, branch)
    start = time.monotonic()
    marks = []

    def mark(label):
        marks.append((label, time.monotonic() - start))
        spent = marks[-1][1] - (marks[-2][1] if len(marks) > 1 else 0)
        say(f"{label}: {spent:.0f}s")

    found = find_orb(key)
    existing = found is not None
    sha = None
    if existing:
        name = found["name"]
        say(f"{name} exists; reusing it")
        ensure_running(name)
    else:
        say(f"creating a machine from {os.environ.get('ORB_SNAPSHOT', 'the box default snapshot')}")
        name, sha = create_machine(key, profile, branch)
    mark("machine found" if existing else "machine created, branch cloned")

    if os.environ.get("ORB_PUBLIC") == "tunnel":
        urls = {port: tunnel_url(name, port) for port in (profile["port"], PANEL_PORT)}
    else:
        for port in (profile["port"], PANEL_PORT):
            if port not in ports(name):
                run(["instabox", "port", "publish", name, str(port)])
        urls = ports(name)
    origin, panel_url = urls[profile["port"]].rstrip("/"), urls[PANEL_PORT].rstrip("/")
    mark("ports published")

    values = {"PUBLIC_ORIGIN": origin, **resolve_secrets(profile)}
    meta = ssh(name, "cat ~/.orb.json 2>/dev/null", check=False).stdout.strip()
    if not meta:
        meta = json.dumps({"repo": repo, "branch": branch, "sha": sha, "origin": origin, "panel": panel_url})
    ssh(name, f"umask 077\nprintf '%s' {shlex.quote(meta)} > ~/.orb.json\ncat > /dev/shm/orb.env <<'ORBENV'\n{exports(values)}ORBENV\n"
              "mkdir -p ~/panel && [ -f ~/panel/index.html ] || echo '<h1>No verification run yet</h1>' > ~/panel/index.html\n"
              f"tmux has-session -t =orbpanel 2>/dev/null || tmux new-session -d -s orbpanel 'cd ~/panel && exec python3 -m http.server {PANEL_PORT} --bind 0.0.0.0'\n")
    mark("secrets and panel placeholder sent")

    if ssh(name, "tmux has-session -t =orb 2>/dev/null", check=False).returncode:
        ssh(name, "cd ~/work && pnpm install --frozen-lockfile 2>&1 | tail -3")
        mark("pnpm install")
        ssh(name, f"cd ~/work && : > /tmp/orb-up.log && tmux new-session -d -s orb \"set -a; . /dev/shm/orb.env; set +a; exec {profile['up']} > /tmp/orb-up.log 2>&1\"")
    ready = shlex.quote(profile["ready"])
    out = ssh(name, f"end=$((SECONDS+{READY_TIMEOUT_S}))\n"
                    f"until grep -qE {ready} /tmp/orb-up.log; do\n"
                    f"  tmux has-session -t =orb 2>/dev/null || {{ echo 'stack exited before ready'; tail -40 /tmp/orb-up.log; exit 1; }}\n"
                    f"  [ $SECONDS -lt $end ] || {{ echo 'timed out waiting for ready'; tail -40 /tmp/orb-up.log; exit 1; }}\n"
                    f"  sleep 2\ndone\ngrep -E {ready} /tmp/orb-up.log | tail -1 | sed -E 's/credentials=[^ ]+//'\n").stdout.strip()
    mark("stack ready")
    doc = ssh(name, f"set -a; . /dev/shm/orb.env; set +a; cd ~/work && {profile['doctor']}", check=False)
    if doc.returncode:
        print(f"orb      {name}\npreview  {origin}/ (doctor failed, not usable)\ntime-to-ready {marks[-1][1]:.0f}s ({phases(marks)})")
        raise OrbError(f"doctor failed on {name}; the machine is kept for inspection:\n{(doc.stdout + doc.stderr).strip()[-1500:]}")
    mark("doctor passed")
    signin = ssh(name, f"set -a; . /dev/shm/orb.env; set +a; cd ~/work && {profile['signin']}").stdout.strip()
    drift = ssh(name, "git -C ~/work rev-parse HEAD").stdout.strip()
    tip = run(["git", "ls-remote", f"https://github.com/{profile['slug']}.git", f"refs/heads/{branch}"], check=False).stdout.split()
    if tip and tip[0] != drift:
        say(f"branch moved to {tip[0][:8]}; this Orb runs {drift[:8]}. `orb down` and `orb up` to refresh")

    print(f"orb      {name}")
    print(f"preview  {origin}/")
    print(f"panel    {panel_url}/")
    print(f"sign-in  {signin}")
    print(f"ready    {out}")
    print(f"time-to-URL {marks[-1][1]:.0f}s ({phases(marks)})")


def cmd_verify(name):
    profile = parse_name(name)
    run_id = "orb-" + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    script = ("set -a; . /dev/shm/orb.env; set +a\ncd ~/work\n"
              f"RUN={run_id}; mkdir -p .verify/$RUN\n"
              f"( {profile['verify_prep']} ) >/tmp/orb-prep.log 2>&1 || {{ echo 'verify prep failed'; tail -20 /tmp/orb-prep.log; exit 1; }}\n"
              "rows=''\n")
    for j, cmd in profile["journeys"].items():
        script += (f"t=$SECONDS; ( {cmd} ) > .verify/$RUN/{j}.log 2>&1; rc=$?\n"
                   f"rows=\"$rows{{\\\"journey\\\":\\\"{j}\\\",\\\"exit\\\":$rc,\\\"seconds\\\":$((SECONDS-t))}},\"\n"
                   f"echo \"{j}: exit $rc\"\n")
    script += f"echo \"[${{rows%,}}]\" > .verify/$RUN/summary.json\necho {run_id}\n"
    p = ssh(name, script, check=False)
    sys.stdout.write(p.stdout)
    if p.returncode:
        raise OrbError(f"verify could not run: {p.stderr.strip()[-800:]}")
    summary = json.loads(ssh(name, f"cat ~/work/.verify/{run_id}/summary.json").stdout)
    failed = [r["journey"] for r in summary if r["exit"]]
    if failed:
        raise OrbError("journeys failed: " + ", ".join(failed))


def pull_verify(name, dest):
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    tar = download_tar(name, "tar -C ~/work -c .verify")
    subprocess.run(["tar", "-x", "-C", str(dest)], input=tar, check=True)


def build_panel(name, meta, evidence, out):
    runs = sorted((d for d in (evidence / ".verify").glob("orb-*") if (d / "summary.json").exists()), key=lambda d: d.name)
    latest = runs[-1] if runs else None
    shutil.rmtree(out, ignore_errors=True)
    (out / "files").mkdir(parents=True)
    summary = json.loads((latest / "summary.json").read_text()) if latest else []
    shots, videos, budgets = [], [], []
    for j in summary:
        log = latest / f"{j['journey']}.log"
        if log.exists():
            shutil.copy2(log, out / "files" / log.name)
        d = evidence / ".verify" / f"{latest.name}-{j['journey']}"
        for f in sorted(d.rglob("*")) if d.exists() else []:
            if not f.is_file():
                continue
            rel = f"files/{d.name}/{f.relative_to(d)}"
            (out / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, out / rel)
            if f.suffix.lower() in (".png", ".jpg"):
                shots.append((j["journey"], rel))
            elif f.suffix.lower() in (".webm", ".mp4"):
                videos.append((j["journey"], rel))
            elif f.name == "budgets.json":
                budgets.append((j["journey"], f.read_text()))
    pr = run(["gh", "pr", "list", "-R", PROFILES[meta["repo"]]["slug"], "--head", meta["branch"], "--state", "all",
              "--json", "number,title,body,url,files"], check=False)
    prs = json.loads(pr.stdout or "[]") if pr.returncode == 0 else []
    e = html.escape
    page = [f"<!doctype html><meta charset=utf-8><title>Orb {e(name)}</title>",
            "<style>body{font:15px/1.5 system-ui;max-width:980px;margin:2rem auto;padding:0 1rem}img,video{max-width:100%;border:1px solid #ccc;margin:.3rem 0}"
            ".pass{color:#0a7d2c}.fail{color:#b00020}pre{white-space:pre-wrap;background:#f6f6f6;padding:.6rem}</style>",
            f"<h1>{e(meta['repo'])} · {e(meta['branch'])}</h1><p>Commit <code>{e((meta.get('sha') or '')[:10])}</code> · preview <a href='{e(meta['origin'])}/'>{e(meta['origin'])}</a></p>",
            "<h2>Journeys</h2>"]
    if not latest:
        page.append("<p class=fail>No verification run yet. Run <code>orb verify</code>.</p>")
    for j in summary:
        ok = j["exit"] == 0
        page.append(f"<p class={'pass' if ok else 'fail'}>{'PASS' if ok else 'FAIL'} <b>{e(j['journey'])}</b> ({j['seconds']}s) <a href='files/{e(j['journey'])}.log'>log</a></p>")
    page.append("<h2>Screenshots</h2>" + ("".join(f"<div><small>{e(j)}</small><br><img src='{e(r)}' loading=lazy></div>" for j, r in shots) or "<p>None.</p>"))
    page.append("<h2>Recordings</h2>" + ("".join(f"<div><small>{e(j)}</small><br><video src='{e(r)}' controls preload=none></video></div>" for j, r in videos) or "<p>None recorded by this repo's journeys.</p>"))
    page.append("<h2>Budgets</h2>" + ("".join(f"<p><b>{e(j)}</b></p><pre>{e(t)}</pre>" for j, t in budgets) or "<p>No budget numbers recorded.</p>"))
    if prs:
        p = prs[0]
        page.append(f"<h2>Change story</h2><p><a href='{e(p['url'])}'>#{p['number']} {e(p['title'])}</a></p><pre>{e(p['body'] or '')}</pre>")
        page.append("<h2>Files touched</h2><ul>" + "".join(f"<li><code>{e(f['path'])}</code> +{f['additions']} −{f['deletions']}</li>" for f in p["files"]) + "</ul>")
    else:
        page.append("<h2>Change story</h2><p>No pull request found for this branch.</p>")
    (out / "index.html").write_text("\n".join(page))


def scan_for_secrets(profile, root):
    values = [v for v in resolve_secrets(profile).values() if len(v) >= 8]
    for f in root.rglob("*"):
        if f.is_file() and f.suffix.lower() in (".json", ".log", ".html", ".txt", ".md"):
            text = f.read_text(errors="ignore")
            if any(v in text for v in values):
                raise OrbError(f"a credential appears in {f}; not publishing the panel")


def cmd_panel(name, serve=True):
    profile = parse_name(name)
    meta = read_meta(name)
    work = CACHE / "orbs" / name
    evidence, out = work / "evidence", work / "panel"
    pull_verify(name, evidence)
    build_panel(name, meta, evidence, out)
    scan_for_secrets(profile, out)
    if serve:
        tar = subprocess.run(["tar", "-C", str(out), "-c", "."], capture_output=True, check=True).stdout
        upload(name, tar, "~/panel")
        print(f"panel    {meta['panel']}/")
    return out, evidence, meta


def cmd_status():
    for m in machines():
        n = m["name"]
        if not n.startswith("box-orb-"):
            continue
        urls = ports(n)
        try:
            app = urls.get(parse_name(n)["port"], "-")
        except OrbError:
            app = "-"
        print(f"{n}  {m.get('state')}  preview={app}  panel={urls.get(PANEL_PORT, '-')}")


def cmd_down(name):
    profile = parse_name(name)
    out, evidence, meta = cmd_panel(name, serve=False)
    branch = re.sub(r"[^A-Za-z0-9._-]+", "-", meta["branch"])
    dest = PANELS_DIR / meta["repo"] / f"{branch}-{(meta.get('sha') or 'unknown')[:8]}"
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    shutil.copytree(out, dest / "panel")
    if (evidence / ".verify").exists():
        shutil.copytree(evidence / ".verify", dest / ".verify")
    say(f"saved panel and evidence to {dest}")
    shutil.rmtree(CACHE / "repos" / re.sub(r"-\d+-\d+$", "", name.removeprefix("box-")), ignore_errors=True)
    ssh(name, f"set -a; . /dev/shm/orb.env; set +a; cd ~/work && {profile['down']} >/dev/null 2>&1; true", check=False)
    for _ in range(3):
        if run(["instabox", "rm", name], check=False).returncode == 0:
            print(f"deleted {name}\nsaved   {dest}")
            return
        time.sleep(10)
    raise OrbError(f"could not delete {name}; remove it with: instabox rm {name}")


def main(argv):
    try:
        match argv:
            case ["up", repo, branch]: cmd_up(repo, branch)
            case ["verify", name]: cmd_verify(name)
            case ["panel", name]: cmd_panel(name)
            case ["status"]: cmd_status()
            case ["down", name]: cmd_down(name)
            case _:
                print(__doc__, file=sys.stderr)
                return 64
    except OrbError as e:
        print(f"orb: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
