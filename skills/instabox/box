#!/bin/bash
# Runs a command on a fresh Instabox machine started from the q9-base snapshot,
# in a checkout of the current repository's HEAD fetched from GitHub, then
# deletes the machine.
#
#   box run [--keep] [--fetch <branch>]... -- '<command>'
#                                     e.g. box run -- 'pnpm install --frozen-lockfile && pnpm gate:full'
#   box runner [--idle <minutes>]     self-hosted GitHub Actions runners, label instabox
#   box ls                            machines that box started
#
# HEAD must be pushed. The checkout also has origin's default branch and every
# --fetch branch as origin/<name>, 200 commits deep. The command itself can't
# fetch, because the GitHub token is gone by the time it runs. Exits with the
# command's exit code. The plan allows 1 machine, so a run waits for a free one.
#
# runner gives each queued job labelled instabox in the current repository a
# fresh machine with a single-job runner, deletes the machine after the job, and
# stops once no job has been queued for --idle minutes (default 10).
set -u
snapshot=${BOX_SNAPSHOT:-q9-base}

usage() { sed -n '2,18p' "$0" >&2; exit 64; }

mode=${1:-}
case "$mode" in
  ls) exec instabox ls --meta box=1 ;;
  run|runner) shift ;;
  *) usage ;;
esac
keep=0
idle=10
branches=()
while (($#)); do
  case "$mode $1" in
    "run --keep") keep=1; shift ;;
    "run --fetch") branches+=("${2:?--fetch needs a branch}"); shift 2 ;;
    "runner --idle") idle=${2:?--idle needs minutes}; shift 2 ;;
    "run --") shift; break ;;
    *) usage ;;
  esac
done
[[ $mode == runner ]] || (($#)) || usage
command="$*"

repo=$(git rev-parse --show-toplevel) || exit 1
sha=$(git -C "$repo" rev-parse HEAD) || exit 1
origin=$(git -C "$repo" remote get-url origin) || exit 1
if [[ $origin =~ ^git@github\.com:(.+)$ ]]; then origin="https://github.com/${BASH_REMATCH[1]}"; fi
[[ $origin == https://github.com/* ]] || { echo "box: origin is not a GitHub URL: $origin" >&2; exit 1; }
if [[ $mode == run && -n $(git -C "$repo" status --porcelain --untracked-files=no) ]]; then
  echo "box: uncommitted changes don't reach the machine. It runs $sha as pushed." >&2
fi
default=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && branches+=("${default#origin/}")
refspecs=""
for b in ${branches[@]+"${branches[@]}"}; do refspecs+=" $(printf %q "+refs/heads/$b:refs/remotes/origin/$b")"; done
token=${BOX_GITHUB_TOKEN:-$(gh auth token)} || exit 1

# Machines whose box call on this Mac has died, and kept machines older than
# 2 hours, would hold a slot forever, so every run deletes them first.
host=$(hostname -s)
instabox ls --meta box=1 --meta "host=$host" --json | python3 -I -c '
import datetime, json, os, sys
now = datetime.datetime.now(datetime.timezone.utc)
for m in json.load(sys.stdin):
    meta = m.get("metadata", {})
    age = now - datetime.datetime.fromisoformat(m["createdAt"].replace("Z", "+00:00"))
    if meta.get("keep") == "1":
        if age > datetime.timedelta(hours=2):
            print(m["name"])
        continue
    try:
        os.kill(int(meta.get("pid", "0")), 0)
    except (ProcessLookupError, ValueError):
        print(m["name"])
    except PermissionError:
        pass' | while read -r stale; do
  instabox rm "$stale" >/dev/null 2>&1 && echo "box: deleted $stale, left behind by a run that ended" >&2
done

prefix=$(basename "$repo" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | cut -c1-20)
start=$(date +%s)
name=""

# Starts a machine named $name, waiting while the plan's machines are all in use.
create() {
  local candidate="box-$prefix-$(date +%H%M%S)-$$" since waiting=0 error
  since=$(date +%s)
  until error=$(instabox create --name "$candidate" --snapshot "$snapshot" --no-vault --secrets none --meta box=1 --meta "host=$host" --meta "pid=$$" --meta "keep=$keep" 2>&1 >/dev/null); do
    # Instabox's API gateway sometimes answers 5xx or times out; that is not a refusal.
    if [[ $error == *"Bad Gateway"* || $error == *"Service Unavailable"* || $error == *"Gateway Time"* || $error == *"handshake timeout"* ]]; then
      sleep 30
      continue
    fi
    [[ $error == *quota_exceeded* ]] || { echo "box: could not create $candidate: $error" >&2; exit 1; }
    ((waiting)) || echo "box: all machines are in use, waiting for one..." >&2
    waiting=1
    sleep 30
  done
  name=$candidate
  echo "box: $name is up after $(( $(date +%s) - since ))s" >&2
}
trap 'exit 130' INT TERM HUP

if [[ $mode == runner ]]; then
  slug=${origin#https://github.com/}
  slug=${slug%.git}
  version=$(gh api repos/actions/runner/releases/latest -q .tag_name) || exit 1
  version=${version#v}

  # Jobs that wait for an instabox runner. Jobs stuck on other runners don't count.
  queued() {
    { for state in queued in_progress; do
        gh api "repos/$slug/actions/runs?status=$state&per_page=100" -q '.workflow_runs[].id' 2>/dev/null
      done; } | sort -u | while read -r run; do
      gh api "repos/$slug/actions/runs/$run/jobs" -q '[.jobs[] | select(.status == "queued" and (.labels | index("instabox")))] | length' 2>/dev/null
    done | awk '{ n += $1 } END { print n + 0 }'
  }
  # true or false while the runner is registered, gone once it isn't, error when GitHub doesn't answer.
  runner_state() {
    local state
    state=$(gh api "repos/$slug/actions/runners" -q ".runners[] | select(.name == \"$name\") | .busy" 2>/dev/null) || { echo error; return; }
    echo "${state:-gone}"
  }
  # A runner left registered would take no jobs but would still be listed, so
  # the registration goes before the machine.
  cleanup() {
    [[ -n $name ]] || return 0
    local id
    id=$(gh api "repos/$slug/actions/runners" -q ".runners[] | select(.name == \"$name\") | .id" 2>/dev/null)
    [[ -n $id ]] && gh api -X DELETE "repos/$slug/actions/runners/$id" >/dev/null 2>&1
    instabox rm "$name" >/dev/null 2>&1 || echo "box: could not delete $name, remove it with: instabox rm $name" >&2
    name=""
  }
  trap cleanup EXIT

  # A job can leave a process behind that reads the secrets of the next job on
  # the same machine, so every job gets its own machine and single-job runner.
  echo "box: serving $slug until no job has been queued for $idle minutes" >&2
  last_busy=$(date +%s)
  while :; do
    if (( $(queued) == 0 )); then
      if (( $(date +%s) - last_busy >= idle * 60 )); then
        echo "box: no job for $idle minutes, stopping after $(( ($(date +%s) - start) / 60 )) minutes" >&2
        exit 0
      fi
      sleep 30
      continue
    fi
    create
    registration=$(gh api -X POST "repos/$slug/actions/runners/registration-token" -q .token) || exit 1
    {
      echo 'read -r T'
      printf '%s\n' "$registration"
      cat <<EOF
mkdir -p ~/runner && cd ~/runner
curl -fsSL https://github.com/actions/runner/releases/download/v$version/actions-runner-linux-x64-$version.tar.gz | tar xz
sudo ./bin/installdependencies.sh >/dev/null
./config.sh --unattended --ephemeral --url $(printf %q "https://github.com/$slug") --token "\$T" --name $name --labels instabox >/dev/null || exit 97
unset T
exec ./run.sh
EOF
    } | instabox ssh "$name" -- bash -l -s &
    runner=$!
    # The runner signs off after its job, but the ssh session can stall and
    # never report that, so the sign-off ends the wait. A runner whose job was
    # cancelled before it took one would wait forever, so that ends it too.
    seen=0
    idle_checks=0
    while kill -0 "$runner" 2>/dev/null; do
      sleep 30
      state=$(runner_state)
      [[ $state == true || $state == false ]] && seen=1
      ((seen)) && [[ $state == gone ]] && break
      if [[ $state == false || $state == gone ]] && (( $(queued) == 0 )); then
        ((++idle_checks >= 2)) && break
      else
        idle_checks=0
      fi
    done
    cleanup
    kill -9 "$runner" 2>/dev/null
    wait "$runner"
    status=$?
    ((status == 97)) && { echo "box: GitHub did not register the runner" >&2; exit 1; }
    last_busy=$(date +%s)
  done
fi

create
((keep)) || trap 'instabox rm "$name" >/dev/null 2>&1 || echo "box: could not delete $name, remove it with: instabox rm $name" >&2' EXIT
echo "box: running $sha on $name" >&2

# The token arrives on stdin, is used for one fetch, and is never stored on the
# machine or visible to the command, which runs after it is unset.
{
  echo 'read -r T'
  printf '%s\n' "$token"
  cat <<EOF
mkdir -p ~/work && cd ~/work && git init -q && git remote add origin $(printf %q "$origin")
git -c http.extraHeader="Authorization: Basic \$(printf 'x-access-token:%s' "\$T" | base64 -w0)" fetch -q --depth 200 origin $sha$refspecs || { unset T; echo "box: fetching $sha$refspecs from origin failed. Push HEAD first, and check the --fetch names." >&2; exit 97; }
unset T
git checkout -q $sha
bash -lc $(printf %q "$command") </dev/null
EOF
} | instabox ssh "$name" -- bash -l -s
status=$?
echo "box: exit $status after $(( $(date +%s) - start ))s" >&2
((keep)) && echo "box: kept $name. Reach it with: instabox ssh $name" >&2
exit $status
