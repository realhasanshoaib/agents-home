#!/bin/bash
# Runs a command on a fresh Instabox machine started from the q9-base snapshot,
# in a checkout of the current repository's HEAD fetched from GitHub, then
# deletes the machine.
#
#   box run [--keep] [--fetch <branch>]... -- '<command>'
#                                     e.g. box run -- 'pnpm install --frozen-lockfile && pnpm gate:full'
#   box runner [--idle <minutes>]     a self-hosted GitHub Actions runner, label instabox
#   box ls                            machines that box started
#
# HEAD must be pushed. The checkout also has origin's default branch and every
# --fetch branch as origin/<name>, 200 commits deep. The command itself can't
# fetch, because the GitHub token is gone by the time it runs. Exits with the
# command's exit code. The plan allows 1 machine, so a run waits for a free one.
#
# runner registers the machine with the current repository, serves its queued
# Actions jobs, and removes the runner and the machine once no run has been
# queued or in progress for --idle minutes (default 10).
set -u
snapshot=${BOX_SNAPSHOT:-q9-base}

usage() { sed -n '2,17p' "$0" >&2; exit 64; }

mode=${1:-}
case "$mode" in
  ls) exec instabox ls --meta box=1 ;;
  run|runner) shift ;;
  *) usage ;;
esac
keep=0
idle=10
branches=()
while (($#)); do
  case "$mode $1" in
    "run --keep") keep=1; shift ;;
    "run --fetch") branches+=("${2:?--fetch needs a branch}"); shift 2 ;;
    "runner --idle") idle=${2:?--idle needs minutes}; shift 2 ;;
    "run --") shift; break ;;
    *) usage ;;
  esac
done
[[ $mode == runner ]] || (($#)) || usage
command="$*"

repo=$(git rev-parse --show-toplevel) || exit 1
sha=$(git -C "$repo" rev-parse HEAD) || exit 1
origin=$(git -C "$repo" remote get-url origin) || exit 1
if [[ $origin =~ ^git@github\.com:(.+)$ ]]; then origin="https://github.com/${BASH_REMATCH[1]}"; fi
[[ $origin == https://github.com/* ]] || { echo "box: origin is not a GitHub URL: $origin" >&2; exit 1; }
if [[ -n $(git -C "$repo" status --porcelain --untracked-files=no) ]]; then
  echo "box: uncommitted changes don't reach the machine. It runs $sha as pushed." >&2
fi
default=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && branches+=("${default#origin/}")
refspecs=""
for b in ${branches[@]+"${branches[@]}"}; do refspecs+=" $(printf %q "+refs/heads/$b:refs/remotes/origin/$b")"; done
token=${BOX_GITHUB_TOKEN:-$(gh auth token)} || exit 1

# Machines whose box call on this Mac has died, and kept machines older than
# 2 hours, would hold a slot forever, so every run deletes them first.
host=$(hostname -s)
instabox ls --meta box=1 --meta "host=$host" --json | python3 -I -c '
import datetime, json, os, sys
now = datetime.datetime.now(datetime.timezone.utc)
for m in json.load(sys.stdin):
    meta = m.get("metadata", {})
    age = now - datetime.datetime.fromisoformat(m["createdAt"].replace("Z", "+00:00"))
    if meta.get("keep") == "1":
        if age > datetime.timedelta(hours=2):
            print(m["name"])
        continue
    try:
        os.kill(int(meta.get("pid", "0")), 0)
    except (ProcessLookupError, ValueError):
        print(m["name"])
    except PermissionError:
        pass' | while read -r stale; do
  instabox rm "$stale" >/dev/null 2>&1 && echo "box: deleted $stale, left behind by a run that ended" >&2
done

slug=$(basename "$repo" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | cut -c1-20)
name="box-$slug-$(date +%H%M%S)-$$"
start=$(date +%s)
waiting=0
until error=$(instabox create --name "$name" --snapshot "$snapshot" --no-vault --secrets none --meta box=1 --meta "host=$host" --meta "pid=$$" --meta "keep=$keep" 2>&1 >/dev/null); do
  [[ $error == *quota_exceeded* ]] || { echo "box: could not create $name: $error" >&2; exit 1; }
  ((waiting)) || echo "box: all machines are in use, waiting for one..." >&2
  waiting=1
  sleep 30
done
((keep)) || trap 'instabox rm "$name" >/dev/null 2>&1 || echo "box: could not delete $name, remove it with: instabox rm $name" >&2' EXIT
trap 'exit 130' INT TERM HUP
echo "box: $name is up after $(( $(date +%s) - start ))s, running $sha" >&2

if [[ $mode == runner ]]; then
  slug=${origin#https://github.com/}
  slug=${slug%.git}
  version=$(gh api repos/actions/runner/releases/latest -q .tag_name) || exit 1
  version=${version#v}
  registration=$(gh api -X POST "repos/$slug/actions/runners/registration-token" -q .token) || exit 1
  # An idle runner left registered would take no jobs but would still be listed,
  # so the registration goes before the machine.
  trap 'id=$(gh api "repos/$slug/actions/runners" -q ".runners[] | select(.name == \"$name\") | .id" 2>/dev/null)
    [[ -n $id ]] && gh api -X DELETE "repos/$slug/actions/runners/$id" >/dev/null 2>&1
    instabox rm "$name" >/dev/null 2>&1 || echo "box: could not delete $name, remove it with: instabox rm $name" >&2' EXIT
  {
    echo 'read -r T'
    printf '%s\n' "$registration"
    cat <<EOF
mkdir -p ~/runner && cd ~/runner
curl -fsSL https://github.com/actions/runner/releases/download/v$version/actions-runner-linux-x64-$version.tar.gz | tar xz
sudo ./bin/installdependencies.sh >/dev/null
./config.sh --unattended --url $(printf %q "$origin") --token "\$T" --name $name --labels instabox >/dev/null || exit 1
unset T
exec ./run.sh
EOF
  } | instabox ssh "$name" -- bash -l -s &
  runner=$!
  echo "box: runner $name serves $slug until it is idle for $idle minutes" >&2
  last_busy=$(date +%s)
  while kill -0 "$runner" 2>/dev/null; do
    sleep 30
    busy=0
    for state in requested waiting pending queued in_progress; do
      count=$(gh api "repos/$slug/actions/runs?status=$state&per_page=1" -q .total_count 2>/dev/null) || count=1
      ((busy += count))
    done
    ((busy)) && last_busy=$(date +%s)
    if (( $(date +%s) - last_busy >= idle * 60 )); then
      echo "box: runner $name was idle for $idle minutes, stopping after $(( ($(date +%s) - start) / 60 )) minutes" >&2
      kill "$runner" 2>/dev/null
      exit 0
    fi
  done
  wait "$runner"
  echo "box: runner $name ended on its own with exit $?" >&2
  exit 1
fi

# The token arrives on stdin, is used for one fetch, and is never stored on the
# machine or visible to the command, which runs after it is unset.
{
  echo 'read -r T'
  printf '%s\n' "$token"
  cat <<EOF
mkdir -p ~/work && cd ~/work && git init -q && git remote add origin $(printf %q "$origin")
git -c http.extraHeader="Authorization: Basic \$(printf 'x-access-token:%s' "\$T" | base64 -w0)" fetch -q --depth 200 origin $sha$refspecs || { unset T; echo "box: fetching $sha$refspecs from origin failed. Push HEAD first, and check the --fetch names." >&2; exit 97; }
unset T
git checkout -q $sha
bash -lc $(printf %q "$command") </dev/null
EOF
} | instabox ssh "$name" -- bash -l -s
status=$?
echo "box: exit $status after $(( $(date +%s) - start ))s" >&2
((keep)) && echo "box: kept $name. Reach it with: instabox ssh $name" >&2
exit $status
